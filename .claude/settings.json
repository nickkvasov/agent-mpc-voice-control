{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; [ -x \"$d/scripts/hooks/guard-spec-branch-base.sh\" ] || exit 0; exec \"$d/scripts/hooks/guard-spec-branch-base.sh\"",
            "timeout": 10,
            "statusMessage": "Checking spec branch base"
          }
        ]
      }
    ]
  }
}
