# Server-only. These are read by the backend in server/ and MUST NOT be
# exposed to the browser bundle — see contracts/backend-http.md and the
# constitution's "credentials never reach the browser".
#
# Vite inlines any variable prefixed VITE_ into the client bundle. Neither of
# these carries that prefix, and neither ever should. T027 asserts it.

# YouTube Data API v3. Note the quota: 100 search.list calls per DAY for the
# whole project, shared across everyone using the deployment.
YOUTUBE_API_KEY=

# Claude API, for the server-side agent loop (claude-opus-5).
ANTHROPIC_API_KEY=

# Backend port. The browser dev server is 5273 (see vite.config.ts).
PORT=8787
