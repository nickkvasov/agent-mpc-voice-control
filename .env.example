# Server-only. These are read by the backend in server/ and MUST NOT be
# exposed to the browser bundle — see contracts/backend-http.md and the
# constitution's "credentials never reach the browser".
#
# Vite inlines any variable prefixed VITE_ into the client bundle. Neither of
# these carries that prefix, and neither ever should. T027 asserts it.

# YouTube Data API v3. Note the quota: 100 search.list calls per DAY for the
# whole project, shared across everyone using the deployment.
YOUTUBE_API_KEY=

# Claude API, for the server-side agent loop (claude-opus-5).
ANTHROPIC_API_KEY=

# Backend port. The browser dev server is 5273 (see vite.config.ts). The
# WebSocket gateway is served by this same process on /mcp.
PORT=8787

# Where the page dials its MCP connection. Defaults to ws://localhost:$PORT.
# Set it when the backend is reached through another origin.
GATEWAY_ORIGIN=

# Assistant spend limits (FR-046, research R8). Checked before a turn starts.
# The daily limit is deployment-wide and resets at midnight Pacific, the same
# moment as the search budget.
ASSISTANT_TURNS_PER_SESSION=40
ASSISTANT_TURNS_PER_DAY=400
